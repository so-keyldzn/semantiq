        {
          "id": "walk.rs",
          "any": [
            "ignore/src/walk\\.rs$"
          ]
        }
      ],
      "allowed": [
        "ignore/src/(gitignore|overrides|types|pathutil|lib)\\.rs$"
      ],
      "min_recall": 0.5
    },
