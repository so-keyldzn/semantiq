      "id": "rg-concept-binary",
      "category": "conceptual",
      "answer_kind": "files",
      "prompt": "How does the search library notice that it is reading a non-text file and then either stop or keep going? Which source files implement that heuristic and its configuration?",
      "expected": [
        {
          "id": "line_buffer.rs",
          "any": [
            "searcher/src/line_buffer\\.rs$"
          ]
        },
        {
          "id": "searcher/mod.rs",
          "any": [
            "searcher/src/searcher/mod\\.rs$"
          ]
        }
      ],
      "allowed": [
        "searcher/src/searcher/(core|glue)\\.rs$",
        "searcher/src/lib\\.rs$",
        "core/flags/hiargs\\.rs$",
        "core/search\\.rs$",
        "core/flags/defs\\.rs$",
        "searcher/src/sink\\.rs$",
        "printer/src/"
      ],
      "min_recall": 0.5
    },
    {
      "id": "rg-concept-ignore-decision",
      "category": "conceptual",
      "answer_kind": "files",
      "prompt": "When walking a directory tree, where is the final decision made that a given entry should be skipped, combining ignore files, overrides, file types and hidden-file rules? List the source files that implement that combination (not the individual rule parsers).",
      "expected": [
        {
          "id": "dir.rs",
          "any": [
            "ignore/src/dir\\.rs$"
          ]
